{
  "name": "genorra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "node --import ./tests/rls/register.mjs ./tests/rls/run.mjs",
    "db:check": "node scripts/migrations.mjs check",
    "db:audit": "npx supabase db query -f supabase/scripts/audit_policy_shadowing.sql",
    "audit:people": "node scripts/people-writes.mjs",
    "audit:family-scope": "node scripts/family-scope.mjs",
    "audit:time": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/time-display.mjs",
    "audit:rls-cases": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/rls-coverage.mjs",
    "sitemap:check": "node scripts/sitemap-freshness.mjs",
    "help:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/help-check.mjs",
    "marketing:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/marketing-coverage.mjs",
    "i18n:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/i18n-coverage.mjs",
    "audit:client-hooks": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/client-hooks.mjs",
    "i18n:literals": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/i18n-literals.mjs",
    "auth-email:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env.local scripts/auth-email-check.mjs",
    "i18n:accept": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/i18n-coverage.mjs accept",
    "email:check": "node scripts/auth-templates.mjs check",
    "email:push": "node scripts/auth-templates.mjs push",
    "email:pull": "node scripts/auth-templates.mjs pull",
    "art:check": "node scripts/kit-illustration.mjs check",
    "billing:trace": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/billing-trace.mjs",
    "realtime:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/realtime-check.mjs",
    "art:build": "node scripts/kit-illustration.mjs build"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@hookform/resolvers": "^5.4.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.77.0",
    "shadcn": "^4.10.0",
    "stripe": "^22.5.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
